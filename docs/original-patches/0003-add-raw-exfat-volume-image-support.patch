+// Raw exFAT volume images. ExFatVolume parses directories lazily and serializes its own I/O.
+class ExFatReaderBackend final: public ArchiveReader {
+public:
+	explicit ExFatReaderBackend(std::unique_ptr<ExFatVolume> volume): m_volume(std::move(volume)) {}
+
+	std::optional<Entry> Find(std::string_view member) override {
+		const auto entry = m_volume->Find(member);
+		if (!entry) {
+			return {};
+		}
+		return Entry {entry->id, entry->size, entry->is_file};
+	}
+
+	std::vector<File::DirEntry> List(std::string_view member) override {
+		auto                        items = m_volume->List(member);
+		std::vector<File::DirEntry> result;
+		result.reserve(items.size());
+		for (auto& item: items) {
+			result.push_back({std::move(item.name), item.is_file});
+		}
+		return result;
+	}
+
+	uint64_t Read(uint64_t id, uint64_t offset, uint32_t size, void* data) override {
+		return m_volume->Read(id, offset, size, data);
+	}
+
+private:
+	std::unique_ptr<ExFatVolume> m_volume;
+};
+
+std::shared_ptr<ArchiveReader> OpenExFat(const std::filesystem::path& path) {
+	auto volume = ExFatVolume::Open(path);
+	return volume ? std::make_shared<ExFatReaderBackend>(std::move(volume)) : nullptr;
+}
